---
import { site } from "~/data/site";
import SwirlBackdrop from "./SwirlBackdrop.astro";
import Bouquet from "./Bouquet.astro";
import Ornament from "./Ornament.astro";
---

{/*
 * Hero — single cinematic moment. Massive Poppins-Black headline on a soft
 * pink-to-blue mesh, with a tiny "Chapter 00" mark, floating credentials
 * card on the left, circular price chip on the right, and a 3-column quote
 * band underneath. Custom-drawn spa composition (pink roses + sky-blue
 * ceramic vase) — no stock imagery.
 */}
<section class="relative min-h-[92vh] flex flex-col">
  <SwirlBackdrop />

  {/* Tiny chapter mark — top-left of hero */}
  <div class="container-edge pt-8 md:pt-12 relative">
    <p class="credit-line text-[var(--color-rose-deep)] flex items-center gap-3">
      <span class="w-6 h-px bg-[var(--color-rose-deep)]"></span>
      Chapter 00 — A Welcome
    </p>
  </div>

  {/* TOP: hero copy */}
  <div class="container-edge relative flex-1 pt-8 md:pt-10 pb-12 md:pb-16">
    <div class="grid grid-cols-12 gap-6 items-start">
      {/* Floating credentials card — left */}
      <aside class="reveal hidden md:block col-span-3 mt-44 lg:mt-56">
        <div class="tile bg-[var(--color-white)]/85 backdrop-blur-md border border-[var(--color-white)]/60 max-w-[230px] shadow-[0_25px_60px_-20px_rgb(26_37_48/0.18)]">
          <div class="flex items-start justify-between">
            <span class="text-[0.62rem] font-bold tracking-[0.22em] uppercase text-[var(--color-rose-deep)]">Since {site.established}</span>
            <span
              class="-mt-10 -mr-3 w-14 h-14 blob-1"
              style="background: radial-gradient(circle at 30% 30%, #fde7e8, #eba6a9 60%, #a04a5a);"
              aria-hidden="true"
            ></span>
          </div>
          <p class="mt-3 font-display font-light text-[var(--color-ink)] text-base leading-snug">
            Twenty years of <strong class="font-semibold text-[var(--color-rose-deep)]">JIPMER-trained</strong> dermatology in Kadapa.
          </p>
          <a href="/about" class="inline-block mt-5 text-[0.7rem] tracking-[0.2em] uppercase font-bold text-[var(--color-ink)] underline underline-offset-4 decoration-[var(--color-rose-deep)]">
            Our story →
          </a>
        </div>
      </aside>

      {/* Centre — massive headline */}
      <div class="reveal col-span-12 md:col-span-7 text-center md:text-left">
        <h1 class="display-mega">
          Skin&nbsp;Care.
          <br />
          <span class="!text-[var(--color-rose-rich)]">Refined.</span>
        </h1>

        <p class="mt-6 md:mt-8 text-[var(--color-ink-mid)] text-base md:text-lg max-w-md md:max-w-lg leading-relaxed mx-auto md:mx-0">
          Dermatology, laser and cosmetology — practiced calmly, explained plainly. Our new Kadapa clinic, now open.
        </p>

        <div class="mt-8 md:mt-10 flex flex-wrap items-center gap-5 justify-center md:justify-start">
          <a href="/book" class="btn btn-rose !py-4 !px-9 !text-[0.78rem]">
            Book a Consult
            <span class="arrow" aria-hidden="true">→</span>
          </a>

          {/* Avatar trust group — abstract pink + blue orbs */}
          <div class="flex items-center">
            <div class="flex -space-x-2.5">
              <span class="w-10 h-10 rounded-full ring-2 ring-[var(--color-paper)]" style="background: radial-gradient(circle at 30% 30%, #dce7ee, #5c7a8a);" aria-hidden="true"></span>
              <span class="w-10 h-10 rounded-full ring-2 ring-[var(--color-paper)]" style="background: radial-gradient(circle at 30% 30%, #eba6a9, #a04a5a);" aria-hidden="true"></span>
              <span class="w-10 h-10 rounded-full ring-2 ring-[var(--color-paper)]" style="background: radial-gradient(circle at 30% 30%, #fde7e8, #c97583);" aria-hidden="true"></span>
              <span class="w-10 h-10 rounded-full ring-2 ring-[var(--color-paper)] grid place-items-center bg-[var(--color-ink)] text-[var(--color-paper)] text-[0.66rem] font-bold tracking-tight">
                10k+
              </span>
            </div>
          </div>
        </div>
      </div>

      {/* Right — circular price chip */}
      <aside class="reveal hidden md:flex col-span-2 justify-end mt-2 lg:mt-4">
        <div class="relative w-[120px] h-[120px] lg:w-[140px] lg:h-[140px] rounded-full border border-[var(--color-ink)]/15 grid place-items-center text-center bg-[var(--color-white)]/50 backdrop-blur-sm">
          <div>
            <p class="font-display font-light text-3xl lg:text-4xl text-[var(--color-ink)] leading-none tracking-tight">
              ₹<span class="font-semibold">500</span>
            </p>
            <p class="mt-2 text-[0.6rem] uppercase tracking-[0.2em] font-bold text-[var(--color-rose-deep)]">per consult</p>
          </div>
        </div>
      </aside>
    </div>
  </div>

  {/* DIVIDER ring */}
  <div class="container-edge relative">
    <div class="hairline"></div>
    <div class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 w-12 h-12 rounded-full border border-[var(--color-ink)]/15 bg-[var(--color-paper)] grid place-items-center">
      <span class="w-2 h-2 rounded-full bg-[var(--color-rose-deep)]"></span>
    </div>
  </div>

  {/* BOTTOM: 3-column quote band */}
  <div class="container-edge relative pt-20 md:pt-24 pb-12 md:pb-16">
    <div class="grid grid-cols-12 gap-8 items-end">
      <div class="reveal col-span-12 md:col-span-4 lg:col-span-3 flex justify-center md:justify-start">
        <Bouquet class="w-full max-w-[260px] md:max-w-[320px] h-auto" />
      </div>

      <div class="reveal col-span-12 md:col-span-5 lg:col-span-6 text-center pb-8">
        <p class="font-display text-2xl md:text-3xl font-light text-[var(--color-ink)] leading-snug max-w-xl mx-auto">
          Build the kind of skin care experience our patients tell their friends about — clear answers, calm rooms, real results.
        </p>
        <Ornament size="md" class="mt-7" />
        <p class="mt-4 credit-line text-[var(--color-rose-deep)]">
          A clinic worth the trip
        </p>
      </div>

      <div class="reveal col-span-12 md:col-span-3 text-center md:text-right pb-8">
        <p class="font-display text-3xl md:text-4xl font-light text-[var(--color-ink)] leading-tight">
          Awaken<br />
          <span class="accent-italic">Better Skin.</span>
        </p>
        <a
          href="/book"
          class="inline-block mt-5 text-[0.72rem] uppercase tracking-[0.28em] font-bold text-[var(--color-ink)] underline underline-offset-[6px] decoration-[var(--color-rose-deep)] decoration-2"
        >
          Book Now →
        </a>
      </div>
    </div>
  </div>
</section>
