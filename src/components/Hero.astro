---
import { site } from "~/data/site";
import Leaf from "./Leaf.astro";
---

{/*
 * Hero — bento mosaic (8 tiles). Deliberately *not* the split-hero pattern
 * used by sudhahospitals / vinithacreations / prodaxis. Each tile is its
 * own statement: brand mark, big headline, brand quote, doctor card,
 * hours, stats, CTA, location pill.
 */}
<section class="relative pt-8 md:pt-12 pb-16 md:pb-24 overflow-hidden">
  <div
    class="absolute inset-0 -z-10 pointer-events-none"
    aria-hidden="true"
    style="background:
      radial-gradient(50% 60% at 100% 0%, color-mix(in oklab, var(--color-sage) 50%, transparent) 0%, transparent 65%),
      radial-gradient(45% 55% at 0% 100%, color-mix(in oklab, var(--color-rose-soft) 65%, transparent) 0%, transparent 65%),
      var(--color-cashmere);"
  ></div>

  <div class="container-edge">
    <div
      class="grid gap-3 md:gap-4 grid-cols-2 md:grid-cols-6 auto-rows-[110px] md:auto-rows-[140px] lg:auto-rows-[150px]"
    >
      {/* TILE 1 — Brand wordmark + tagline */}
      <div class="reveal col-span-2 row-span-2 md:col-span-3 md:row-span-3 tile tile-cashmere flex flex-col justify-between p-7 md:p-10">
        <div class="flex items-center justify-between">
          <span class="eyebrow">Est. {site.established} · {site.city}</span>
          <Leaf size={32} color="var(--color-laurel)" rotation={-15} opacity={0.6} />
        </div>
        <h1 class="display-1">
          Skin care, <br />
          made <span class="accent-italic">soft.</span>
        </h1>
        <p class="text-[var(--color-ink-soft)] text-sm md:text-base max-w-sm leading-relaxed">
          A clinic the way it should be — natural, calm, and rooted in evidence. Twenty years of dermatology, three doctors, one quiet promise.
        </p>
      </div>

      {/* TILE 2 — Sage mood line */}
      <div class="reveal col-span-2 row-span-1 md:col-span-3 md:row-span-1 tile tile-sage flex items-center justify-between p-7">
        <p class="font-display text-lg md:text-xl font-light leading-tight max-w-[24ch]">
          Natural &middot; Soft &middot; <em class="not-italic font-normal">Organic</em>
        </p>
        <Leaf size={36} color="var(--color-laurel)" rotation={45} opacity={0.7} />
      </div>

      {/* TILE 3 — Rose CTA */}
      <div class="reveal col-span-2 row-span-1 md:col-span-2 md:row-span-2 tile tile-rose flex flex-col justify-between p-6 md:p-7">
        <span class="eyebrow !text-[var(--color-laurel-deep)]/70">Book today</span>
        <div>
          <p class="display-3 !text-[var(--color-laurel-deep)] leading-[1.05]">
            A consult.
            <br />
            <span class="font-light italic opacity-80">Then a plan.</span>
          </p>
          <a href="/book" class="btn btn-primary mt-5 !text-xs !py-3 !px-5">
            Book Visit
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      {/* TILE 4 — Hours */}
      <div class="reveal col-span-1 row-span-1 tile p-5 md:p-6 flex flex-col justify-between">
        <span class="eyebrow">Today</span>
        <div>
          <p class="font-display text-xl md:text-2xl font-light text-[var(--color-laurel)] leading-tight">9:30 — 1:30</p>
          <p class="font-display text-xl md:text-2xl font-light text-[var(--color-laurel)] leading-tight">5:00 — 8:00</p>
        </div>
      </div>

      {/* TILE 5 — Patients stat */}
      <div class="reveal col-span-1 row-span-1 tile tile-laurel p-5 md:p-6 flex flex-col justify-between">
        <span class="eyebrow !text-[var(--color-rose-soft)]/80">Patients</span>
        <p class="font-display text-2xl md:text-3xl font-light leading-none">10k<span class="accent-italic">+</span></p>
      </div>

      {/* TILE 6 — Years + Specialists */}
      <div class="reveal col-span-2 md:col-span-2 row-span-1 tile p-6 flex items-center justify-between">
        <div>
          <span class="eyebrow">Years</span>
          <p class="font-display text-3xl md:text-4xl font-extralight text-[var(--color-laurel)] leading-none mt-1 tracking-tight">
            20<span class="accent-italic">+</span>
          </p>
        </div>
        <div class="text-right">
          <span class="eyebrow">Specialists</span>
          <p class="font-display text-3xl md:text-4xl font-extralight text-[var(--color-laurel)] leading-none mt-1 tracking-tight">
            03
          </p>
        </div>
      </div>

      {/* TILE 7 — Founder card */}
      <div class="reveal col-span-2 md:col-span-2 row-span-2 tile p-6 flex flex-col justify-between">
        <div class="flex items-center gap-4">
          <div
            class="w-16 h-16 grid place-items-center bg-gradient-to-br from-[var(--color-sage)] to-[var(--color-olive)] text-[var(--color-laurel-deep)] font-display text-2xl font-light shrink-0 blob-1"
          >
            ES
          </div>
          <div>
            <span class="eyebrow">Founder</span>
            <p class="font-display text-base md:text-lg text-[var(--color-laurel)] mt-1 leading-tight">Dr. E.V. Subba Reddy</p>
          </div>
        </div>
        <p class="text-xs md:text-sm text-[var(--color-ink-muted)] leading-relaxed">
          MD, DD &middot; Ex-Registrar, JIPMER Hospital, Pondicherry. Two decades of dermatology, taught the way it was practiced — diagnose, then prescribe.
        </p>
        <a href="/doctors#subba-reddy" class="text-xs uppercase tracking-[0.18em] text-[var(--color-rose-deep)] font-bold hover:underline">
          Read profile →
        </a>
      </div>

      {/* TILE 8 — Location pin */}
      <div class="reveal col-span-2 md:col-span-2 row-span-1 tile tile-laurel p-6 flex items-center justify-between">
        <div>
          <span class="eyebrow !text-[var(--color-rose-soft)]/80">New clinic</span>
          <p class="font-display text-lg md:text-xl font-light leading-tight mt-1">{site.address.area}, {site.address.city}</p>
        </div>
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address.mapsQuery)}`}
          target="_blank"
          rel="noopener"
          class="grid place-items-center w-12 h-12 rounded-full bg-[var(--color-rose)] text-[var(--color-laurel-deep)] hover:scale-105 transition-transform"
          aria-label="Open in Maps"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M12 22s-7-7.58-7-12a7 7 0 1 1 14 0c0 4.42-7 12-7 12Z" stroke-linejoin="round"/>
            <circle cx="12" cy="10" r="2.5"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
