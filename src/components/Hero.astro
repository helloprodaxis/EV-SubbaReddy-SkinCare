---
import { site } from "~/data/site";
import SwirlBackdrop from "./SwirlBackdrop.astro";
import Bouquet from "./Bouquet.astro";
---

{/*
 * Hero — single-focal moment. One massive bold headline on a soft cream-swirl
 * backdrop, with a credentials card floating left and a price chip floating
 * right. Trust signals (avatars + count) sit beneath the CTA. Below the fold:
 * a 3-column quote panel with a hand-drawn bouquet.
 *
 * Design references: Augustinus Bader, Aesop, Celestia (the screenshot the
 * client shared). All assets are CSS/SVG we own — no stock imagery.
 */}
<section class="relative min-h-[92vh] flex flex-col">
  <SwirlBackdrop />

  {/* TOP: hero copy */}
  <div class="container-edge relative flex-1 pt-12 md:pt-20 pb-12 md:pb-16">
    <div class="grid grid-cols-12 gap-6 items-start">
      {/* Floating credentials card — left */}
      <aside class="reveal hidden md:block col-span-3 md:col-span-3 mt-44 lg:mt-56">
        <div class="tile bg-[var(--color-white)]/90 backdrop-blur-md border border-[var(--color-white)]/60 max-w-[230px] shadow-[0_25px_60px_-20px_rgb(45_54_43/0.18)]">
          <div class="flex items-start justify-between">
            <span class="text-[0.62rem] font-bold tracking-[0.22em] uppercase text-[var(--color-olive)]">Since {site.established}</span>
            {/* Tiny rose pebble decoration */}
            <span
              class="-mt-10 -mr-3 w-14 h-14 blob-1"
              style="background: radial-gradient(circle at 30% 30%, #f3cdce, #d77f83 70%, #a85f63);"
              aria-hidden="true"
            ></span>
          </div>
          <p class="mt-3 font-display font-light text-[var(--color-laurel)] text-base leading-snug">
            Twenty years of <strong class="font-semibold text-[var(--color-rose-deep)]">JIPMER-trained</strong> dermatology in Kadapa.
          </p>
          <a href="/about" class="inline-block mt-5 text-[0.7rem] tracking-[0.2em] uppercase font-bold text-[var(--color-laurel)] underline underline-offset-4 decoration-[var(--color-rose-deep)]">
            Our story →
          </a>
        </div>
      </aside>

      {/* Centre — massive headline */}
      <div class="reveal col-span-12 md:col-span-7 text-center md:text-left">
        <h1 class="display-mega">
          Skin&nbsp;Care.
          <br />
          <span class="!text-[var(--color-rose-deep)]">Refined.</span>
        </h1>

        <p class="mt-6 md:mt-8 text-[var(--color-ink-soft)] text-base md:text-lg max-w-md md:max-w-lg leading-relaxed mx-auto md:mx-0">
          Dermatology, laser and cosmetology — practiced calmly, explained plainly. Our new Kadapa clinic, now open.
        </p>

        {/* CTA + trust group */}
        <div class="mt-8 md:mt-10 flex flex-wrap items-center gap-5 justify-center md:justify-start">
          <a href="/book" class="btn !bg-[var(--color-mauve)] !text-[var(--color-cashmere-soft)] hover:!bg-[var(--color-laurel)] !py-4 !px-9 !text-[0.78rem]">
            Book a Consult
            <span class="arrow" aria-hidden="true">→</span>
          </a>

          {/* Avatar trust group — abstract orbs (no real photos) */}
          <div class="flex items-center">
            <div class="flex -space-x-2.5">
              <span class="w-10 h-10 rounded-full ring-2 ring-[var(--color-cashmere)]" style="background: radial-gradient(circle at 30% 30%, #d4dcd1, #6b7466);" aria-hidden="true"></span>
              <span class="w-10 h-10 rounded-full ring-2 ring-[var(--color-cashmere)]" style="background: radial-gradient(circle at 30% 30%, #eba6a9, #a85f63);" aria-hidden="true"></span>
              <span class="w-10 h-10 rounded-full ring-2 ring-[var(--color-cashmere)]" style="background: radial-gradient(circle at 30% 30%, #f3cdce, #d77f83);" aria-hidden="true"></span>
              <span class="w-10 h-10 rounded-full ring-2 ring-[var(--color-cashmere)] grid place-items-center bg-[var(--color-laurel)] text-[var(--color-cashmere-soft)] text-[0.66rem] font-bold tracking-tight">
                10k+
              </span>
            </div>
          </div>
        </div>
      </div>

      {/* Right — circular price/badge chip */}
      <aside class="reveal hidden md:flex col-span-2 justify-end mt-2 lg:mt-4">
        <div class="relative w-[120px] h-[120px] lg:w-[140px] lg:h-[140px] rounded-full border border-[var(--color-laurel)]/15 grid place-items-center text-center bg-[var(--color-cashmere)]/40 backdrop-blur-sm">
          <div>
            <p class="font-display font-light text-3xl lg:text-4xl text-[var(--color-laurel)] leading-none tracking-tight">
              ₹<span class="font-semibold">500</span>
            </p>
            <p class="mt-2 text-[0.6rem] uppercase tracking-[0.2em] font-bold text-[var(--color-olive)]">per consult</p>
          </div>
        </div>
      </aside>
    </div>
  </div>

  {/* DIVIDER ring like the Celestia ref */}
  <div class="container-edge relative">
    <div class="hairline"></div>
    <div class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 w-12 h-12 rounded-full border border-[var(--color-laurel)]/15 bg-[var(--color-cashmere)] grid place-items-center">
      <span class="w-2 h-2 rounded-full bg-[var(--color-rose-deep)]"></span>
    </div>
  </div>

  {/* BOTTOM: 3-column quote band — bouquet | quote | CTA */}
  <div class="container-edge relative pt-20 md:pt-24 pb-12 md:pb-16">
    <div class="grid grid-cols-12 gap-8 items-end">
      {/* Bouquet illustration */}
      <div class="reveal col-span-12 md:col-span-4 lg:col-span-3 flex justify-center md:justify-start">
        <Bouquet width={320} height={440} />
      </div>

      {/* Centre quote */}
      <div class="reveal col-span-12 md:col-span-5 lg:col-span-6 text-center pb-8">
        <p class="font-display text-2xl md:text-3xl font-light text-[var(--color-laurel)] leading-snug max-w-xl mx-auto">
          Build the kind of skin care experience our patients tell their friends about — clear answers, calm rooms, real results.
        </p>
        <div class="mt-6 flex items-center justify-center gap-2 text-[var(--color-rose-deep)]" aria-hidden="true">
          <span class="w-1 h-1 rounded-full bg-current"></span>
          <span class="w-2 h-2 rounded-full bg-current"></span>
          <span class="w-1 h-1 rounded-full bg-current"></span>
        </div>
        <p class="mt-3 text-[0.7rem] uppercase tracking-[0.32em] font-bold text-[var(--color-olive)]">
          A clinic worth the trip
        </p>
      </div>

      {/* Right side CTA column */}
      <div class="reveal col-span-12 md:col-span-3 text-center md:text-right pb-8">
        <p class="font-display text-3xl md:text-4xl font-light text-[var(--color-laurel)] leading-tight">
          Awaken<br />
          <span class="accent-italic">Better Skin.</span>
        </p>
        <a
          href="/book"
          class="inline-block mt-5 text-[0.72rem] uppercase tracking-[0.28em] font-bold text-[var(--color-laurel)] underline underline-offset-[6px] decoration-[var(--color-rose-deep)] decoration-2"
        >
          Book Now →
        </a>
      </div>
    </div>
  </div>
</section>
