---
const pillars = [
  {
    no: "01",
    title: "Diagnose first",
    body:
      "Every visit starts with a real consultation — history, examination, and a plain-English explanation of what's actually going on with your skin.",
  },
  {
    no: "02",
    title: "Evidence-based protocols",
    body:
      "We use what the dermatology literature actually supports — not whatever's trending on Instagram. No mystery serums, no upselling.",
  },
  {
    no: "03",
    title: "Respect your time and money",
    body:
      "Treatments are sequenced for results, not revenue. We tell you up-front how many sessions you'll need, and what they'll cost.",
  },
];
---

<section class="relative py-24 md:py-36 bg-[var(--color-sky-soft)] overflow-hidden">
  {/* Soft pink wash — corner accent */}
  <div
    class="absolute -top-24 -right-24 w-[460px] h-[460px] rounded-full opacity-50 pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(circle, var(--color-blush-deep), transparent 70%);"
  ></div>
  <div
    class="absolute -bottom-32 -left-24 w-[520px] h-[520px] rounded-full opacity-40 pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(circle, var(--color-sky-mid), transparent 70%);"
  ></div>

  <div class="container-edge relative">
    <div class="grid gap-12 lg:gap-20 lg:grid-cols-12 items-start">
      <div class="lg:col-span-5 lg:sticky lg:top-28 reveal">
        <p class="credit-line text-[var(--color-rose-deep)] flex items-center gap-3">
          <span class="w-6 h-px bg-[var(--color-rose-deep)]"></span>
          Chapter 02 — Approach
        </p>
        <h2 class="display-2 mt-6">
          A clinic, not a
          <br />
          <span class="accent-italic">salon.</span>
        </h2>
        <p class="lead mt-6 max-w-md">
          Cosmetic dermatology has been hijacked by marketing. We practice the way our
          training taught us — clinical, conservative, results-led.
        </p>
      </div>

      <ol class="lg:col-span-7 space-y-6">
        {pillars.map((p, i) => (
          <li
            class="reveal tile p-7 md:p-9 grid grid-cols-[auto_1fr] gap-6 items-start"
            class:list={i === 1 ? "lg:ml-12" : ""}
            style={`transition-delay:${i * 80}ms`}
          >
            <span class="font-display text-5xl md:text-6xl font-extralight text-[var(--color-rose-rich)] leading-none tracking-tight">
              {p.no}
            </span>
            <div>
              <h3 class="display-3 leading-tight text-[var(--color-ink)]">{p.title}</h3>
              <p class="lead mt-3 !text-base">{p.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
