---
import Leaf from "./Leaf.astro";

const pillars = [
  {
    no: "01",
    title: "Diagnose first",
    body:
      "Every visit starts with a real consultation — history, examination, and a plain-English explanation of what's actually going on with your skin.",
  },
  {
    no: "02",
    title: "Evidence-based protocols",
    body:
      "We use what the dermatology literature actually supports — not whatever's trending on Instagram. No mystery serums, no upselling.",
  },
  {
    no: "03",
    title: "Respect your time & money",
    body:
      "Treatments are sequenced for results, not revenue. We tell you up-front how many sessions you'll need, and what they'll cost.",
  },
];
---

{/*
 * Approach — sage-misted section, pillars in soft glass tiles. The pillars
 * sit asymmetrically so it doesn't read as a "feature row".
 */}
<section class="relative py-24 md:py-36 bg-[var(--color-sage-mist)] overflow-hidden">
  {/* Floating decorative leaves */}
  <div class="absolute top-12 right-8 md:right-24 pointer-events-none" aria-hidden="true">
    <Leaf size={140} color="var(--color-sage)" rotation={20} opacity={0.35} />
  </div>
  <div class="absolute bottom-12 left-4 md:left-12 pointer-events-none" aria-hidden="true">
    <Leaf size={90} color="var(--color-olive)" rotation={-30} opacity={0.3} />
  </div>

  <div class="container-edge relative">
    <div class="grid gap-12 lg:gap-20 lg:grid-cols-12 items-start">
      <div class="lg:col-span-5 lg:sticky lg:top-28 reveal">
        <p class="eyebrow">02 · Approach</p>
        <h2 class="display-2 mt-4">
          A clinic, not a
          <br />
          <span class="accent-italic">salon.</span>
        </h2>
        <p class="lead mt-6 max-w-md">
          Cosmetic dermatology has been hijacked by marketing. We practice the way our
          training taught us — clinical, conservative, results-led.
        </p>
      </div>

      <ol class="lg:col-span-7 space-y-5">
        {pillars.map((p, i) => (
          <li
            class="reveal tile p-7 md:p-9 grid grid-cols-[auto_1fr] gap-6 items-start"
            class:list={i === 1 ? "lg:ml-12" : ""}
            style={`transition-delay:${i * 80}ms`}
          >
            <span class="font-display text-5xl md:text-6xl font-extralight text-[var(--color-rose-deep)] leading-none tracking-tight">
              {p.no}
            </span>
            <div>
              <h3 class="display-3 leading-tight">{p.title}</h3>
              <p class="lead mt-3 !text-base">{p.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
