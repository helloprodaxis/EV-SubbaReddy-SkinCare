---
const items = [
  "natural",
  "soft",
  "organic",
  "skin",
  "hair",
  "laser",
  "calm",
  "evidence-led",
  "transparent",
  "kadapa",
];
const doubled = [...items, ...items];
---

<div class="relative overflow-hidden py-8 md:py-10 bg-[var(--color-laurel)] text-[var(--color-cashmere-soft)]">
  <div class="ticker">
    {doubled.map((item) => (
      <span class="flex items-center gap-10 shrink-0 font-display text-2xl md:text-4xl font-extralight italic tracking-tight">
        {item}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="3" fill="var(--color-rose)"/>
        </svg>
      </span>
    ))}
  </div>
</div>
