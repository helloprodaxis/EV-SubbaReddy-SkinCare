---
const items = [
  "Skin",
  "Hair",
  "Nail",
  "Allergy",
  "Laser",
  "Pigmentation",
  "Acne",
  "Psoriasis",
  "Vitiligo",
  "Cosmetology",
];
const doubled = [...items, ...items];
---

<div class="relative overflow-hidden border-y border-[color-mix(in_oklab,var(--color-ink)_10%,transparent)] bg-[var(--color-cream)]">
  <div class="marquee py-6">
    {doubled.map((item) => (
      <span class="flex items-center gap-12 shrink-0 font-display text-2xl md:text-4xl font-light text-[var(--color-ink-soft)]">
        {item}
        <span class="text-[var(--color-clay)]" aria-hidden="true">✦</span>
      </span>
    ))}
  </div>
</div>
