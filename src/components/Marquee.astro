---
const items = [
  "skin",
  "hair",
  "laser",
  "calm",
  "evidence-led",
  "considered",
  "transparent",
  "kadapa",
];
const doubled = [...items, ...items];
---

<div class="relative overflow-hidden py-6 md:py-8 border-y border-[color-mix(in_oklab,var(--color-ink)_6%,transparent)] bg-[var(--color-cream)]">
  <div class="ticker">
    {doubled.map((item) => (
      <span class="flex items-center gap-10 shrink-0 font-display text-3xl md:text-5xl font-extralight italic tracking-tight text-[var(--color-ink)]/55">
        {item}
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
          <circle cx="5" cy="5" r="2" fill="var(--color-rose-deep)"/>
        </svg>
      </span>
    ))}
  </div>
</div>
