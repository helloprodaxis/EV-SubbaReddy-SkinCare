---
import { treatments, treatmentCategories } from "~/data/treatments";
import Leaf from "./Leaf.astro";

const featured = treatments.slice(0, 8);

// Cycle through palette colors for the cards.
const cardColors = [
  { bg: "var(--color-sage)",          fg: "var(--color-laurel-deep)", leaf: "var(--color-laurel)" },
  { bg: "var(--color-cashmere-soft)", fg: "var(--color-laurel)",      leaf: "var(--color-olive)" },
  { bg: "var(--color-rose-soft)",     fg: "var(--color-laurel-deep)", leaf: "var(--color-rose-deep)" },
  { bg: "var(--color-laurel)",        fg: "var(--color-cashmere-soft)", leaf: "var(--color-rose)" },
];
---

{/*
 * Treatments — horizontal scroll-snap rail of tall portrait cards.
 * Pure CSS scroll-snap (no JS). Visually distinctive — no other Prodaxis
 * site uses this layout.
 */}
<section class="relative py-20 md:py-28 overflow-hidden">
  <div class="container-edge">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 reveal">
      <div class="max-w-xl">
        <p class="eyebrow">Treatments — 01</p>
        <h2 class="display-2 mt-4">
          What we treat,
          <br />
          <span class="accent-italic">how we treat it.</span>
        </h2>
      </div>
      <div class="flex items-center gap-4 self-start md:self-end">
        <p class="text-sm text-[var(--color-ink-muted)] hidden md:block">
          ← scroll →
        </p>
        <a href="/treatments" class="btn btn-ghost">
          All treatments
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>

  <div class="hairline mt-10 max-w-[84rem] mx-auto"></div>

  <div class="scroll-rail mt-12">
    {featured.map((t, i) => {
      const c = cardColors[i % cardColors.length];
      return (
        <a
          href={`/treatments#${t.slug}`}
          class="reveal group rounded-[var(--r-soft)] p-7 md:p-8 flex flex-col justify-between min-h-[420px] md:min-h-[460px] transition-transform duration-500 hover:-translate-y-1"
          style={`background:${c.bg}; color:${c.fg};`}
        >
          <div class="flex items-start justify-between">
            <span class="text-[0.7rem] uppercase tracking-[0.22em] font-bold opacity-70">
              {String(i + 1).padStart(2, "0")} · {treatmentCategories[t.category].label}
            </span>
            <Leaf size={36} color={c.leaf} rotation={i * 27} opacity={0.8} />
          </div>

          <div>
            <h3 class="font-display font-light text-3xl md:text-4xl leading-[1.05] tracking-tight">
              {t.title}
            </h3>
            <p class="mt-4 text-sm leading-relaxed opacity-85">
              {t.blurb}
            </p>
          </div>

          <div class="flex items-center justify-between text-xs uppercase tracking-[0.18em] font-bold pt-6 border-t border-current/15">
            <span class="opacity-70">{t.duration}</span>
            <span class="arrow opacity-90" aria-hidden="true">→</span>
          </div>
        </a>
      );
    })}
  </div>
</section>
