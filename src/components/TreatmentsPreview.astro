---
import { treatments, treatmentCategories } from "~/data/treatments";
const featured = treatments.slice(0, 6);
---

<section class="container-edge py-24 md:py-32">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 reveal">
    <div class="max-w-xl">
      <p class="eyebrow">Treatments</p>
      <h2 class="display-2 mt-4">
        Medical dermatology,
        <br />
        <span class="accent-italic">elevated.</span>
      </h2>
    </div>
    <a href="/treatments" class="btn btn-ghost self-start md:self-end">
      All treatments
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <div class="hairline mt-10"></div>

  <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {featured.map((t, i) => (
      <li class="reveal" style={`transition-delay:${i * 60}ms`}>
        <a
          href={`/treatments#${t.slug}`}
          class="card block h-full group relative overflow-hidden"
        >
          <span
            class="absolute top-6 right-6 w-2 h-2 rounded-full"
            style={`background:${treatmentCategories[t.category].color}`}
            aria-hidden="true"
          />
          <p class="text-[0.7rem] uppercase tracking-[0.2em] text-[var(--color-ink-muted)]">
            {treatmentCategories[t.category].label}
          </p>
          <h3 class="font-display text-2xl mt-3 leading-tight text-[var(--color-ink)] group-hover:text-[var(--color-clay-deep)] transition-colors">
            {t.title}
          </h3>
          <p class="mt-3 text-sm text-[var(--color-ink-soft)] leading-relaxed">
            {t.blurb}
          </p>
          <div class="mt-6 flex items-center justify-between text-xs text-[var(--color-ink-muted)]">
            <span>{t.duration}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
