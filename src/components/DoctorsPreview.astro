---
import { doctors } from "~/data/doctors";

// Three palette pairings — each card gets its own personality.
const palette = [
  {
    bg: "var(--color-sky-soft)",
    text: "var(--color-sky-rich)",
    accent: "var(--color-sky-deep)",
    avatar: "linear-gradient(135deg, #ffffff 0%, #b8ccd9 60%, #5c7a8a 100%)",
    chip: "var(--color-white)",
  },
  {
    bg: "var(--color-blush)",
    text: "var(--color-mauve)",
    accent: "var(--color-rose-rich)",
    avatar: "linear-gradient(135deg, #ffffff 0%, #f3cdce 55%, #c97583 100%)",
    chip: "var(--color-white)",
  },
  {
    bg: "var(--color-ink)",
    text: "var(--color-blush)",
    accent: "var(--color-rose)",
    avatar: "linear-gradient(135deg, #2a3741 0%, #4a5560 60%, #c97583 100%)",
    chip: "var(--color-paper)",
  },
];

const initials = (name: string) =>
  name.split(" ").slice(1).map((s) => s[0]).join("");
---

{/*
 * DoctorsPreview — editorial chapter card stack. Each doctor gets a
 * distinct background colour drawn from the brand (blue, blush, ink),
 * a large blob-shaped avatar with initials, and the FULL NAME visible.
 *
 * The name visibility bug from the previous version came from the global
 * h3 colour rule overriding the card's foreground colour. Fixed in
 * global.css: headings now inherit colour. We also explicitly set the
 * heading colour here as belt-and-braces.
 */}
<section class="relative py-24 md:py-36">
  <div class="container-edge">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 reveal">
      <div>
        <p class="credit-line text-[var(--color-rose-deep)] flex items-center gap-3">
          <span class="w-6 h-px bg-[var(--color-rose-deep)]"></span>
          Chapter 03 — The Doctors
        </p>
        <h2 class="display-2 mt-6 max-w-2xl">
          Three specialists.
          <br />
          <span class="accent-italic">One standard.</span>
        </h2>
      </div>
      <a href="/doctors" class="btn btn-ghost self-start md:self-end">
        All profiles
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="hairline mt-14"></div>

    <div class="mt-14 grid gap-6 md:grid-cols-3 md:items-stretch">
      {doctors.map((d, i) => {
        const c = palette[i];
        const offset = i === 1 ? "md:translate-y-8" : i === 2 ? "md:-translate-y-4" : "";
        return (
          <a
            href={`/doctors#${d.slug}`}
            class={`reveal group relative block rounded-[var(--r-soft)] p-7 md:p-8 transition-transform duration-500 hover:-translate-y-2 ${offset}`}
            style={`background:${c.bg}; color:${c.text}; transition-delay:${i * 100}ms;`}
          >
            {/* Top row — chapter pill + qualifications */}
            <div class="flex items-start justify-between gap-3">
              <span class="text-[0.62rem] uppercase tracking-[0.28em] font-bold opacity-70">
                {String(i + 1).padStart(2, "0")} — {d.qualifications}
              </span>
              <span
                class="text-[0.62rem] uppercase tracking-[0.22em] font-bold px-3 py-1 rounded-full"
                style={`background:${c.chip}; color:${c.accent};`}
              >
                {d.specialties[0]}
              </span>
            </div>

            {/* Big blob-shaped avatar with initials */}
            <div class="mt-8 flex items-center gap-5">
              <div
                class="w-24 h-24 grid place-items-center font-display text-2xl font-semibold blob-1 transition-all duration-700 group-hover:[border-radius:var(--r-organic-2)]"
                style={`background:${c.avatar}; color:${c.text}; text-shadow:0 1px 2px rgb(0 0 0 / 0.08);`}
              >
                {initials(d.name)}
              </div>
              <div class="flex-1">
                <span class="text-[0.62rem] uppercase tracking-[0.22em] font-bold opacity-70">
                  Dr. 0{i + 1}
                </span>
                {/* The name — colour is forced inline so nothing can hide it. */}
                <h3
                  class="font-display font-light text-2xl mt-1 leading-tight"
                  style={`color:${c.text};`}
                >
                  {d.name}
                </h3>
              </div>
            </div>

            {/* Role */}
            <p class="mt-6 text-base leading-relaxed opacity-90">
              {d.role}
            </p>

            {/* Specialties */}
            <div class="mt-6 pt-5 border-t flex items-center justify-between text-[0.66rem] uppercase tracking-[0.22em] font-bold" style={`border-color:color-mix(in oklab, ${c.text} 18%, transparent);`}>
              <span class="opacity-80">
                {d.specialties.slice(0, 3).join(" · ")}
              </span>
              <span class="arrow opacity-90" aria-hidden="true">→</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
