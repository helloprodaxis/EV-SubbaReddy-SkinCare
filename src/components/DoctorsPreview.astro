---
import { doctors } from "~/data/doctors";
import Leaf from "./Leaf.astro";

const palette = [
  { bg: "var(--color-sage)",   ink: "var(--color-laurel-deep)", accent: "var(--color-laurel)" },
  { bg: "var(--color-rose)",   ink: "var(--color-laurel-deep)", accent: "var(--color-mauve)" },
  { bg: "var(--color-laurel)", ink: "var(--color-cashmere-soft)", accent: "var(--color-rose)" },
];
---

{/*
 * Doctors — overlapping stacked cards with organic-blob avatars.
 * The cards step down/right so the composition feels like a fan, not a row.
 */}
<section class="container-edge py-24 md:py-32">
  <div class="max-w-2xl reveal">
    <p class="eyebrow">03 · The doctors</p>
    <h2 class="display-2 mt-4">
      Three specialists.
      <br />
      <span class="accent-italic">One standard.</span>
    </h2>
  </div>

  <div class="hairline mt-10"></div>

  <div class="mt-14 grid gap-6 md:grid-cols-3 md:items-end">
    {doctors.map((d, i) => {
      const c = palette[i];
      return (
        <a
          href={`/doctors#${d.slug}`}
          class="reveal group block rounded-[var(--r-soft)] p-7 md:p-8 transition-transform hover:-translate-y-2"
          style={`background:${c.bg}; color:${c.ink}; transition-delay:${i * 100}ms; ${i === 1 ? 'margin-top:-1.5rem;' : i === 2 ? '' : ''}`}
        >
          {/* Organic blob avatar — initials inside */}
          <div class="flex items-start justify-between">
            <div
              class="w-20 h-20 grid place-items-center font-display text-3xl font-extralight blob-1 transition-all duration-700 group-hover:[border-radius:var(--r-organic-2)]"
              style={`background:color-mix(in oklab,${c.accent} 25%,transparent); color:${c.ink};`}
            >
              {d.name.split(" ").slice(1).map((s) => s[0]).join("")}
            </div>
            <Leaf size={28} color={c.accent} rotation={i * 30 - 15} opacity={0.8} />
          </div>

          <div class="mt-8">
            <span class="text-[0.68rem] uppercase tracking-[0.22em] font-bold opacity-70">
              0{i + 1} · {d.qualifications}
            </span>
            <h3 class="font-display text-2xl md:text-3xl font-light mt-2 leading-tight">
              {d.name}
            </h3>
            <p class="text-sm mt-2 opacity-80">{d.role}</p>
          </div>

          <div class="mt-8 pt-5 border-t border-current/15 flex items-center justify-between text-[0.7rem] uppercase tracking-[0.18em] font-bold">
            <span class="opacity-70">{d.specialties.slice(0, 3).join(" · ")}</span>
            <span class="arrow opacity-90" aria-hidden="true">→</span>
          </div>
        </a>
      );
    })}
  </div>
</section>
