---
import { testimonials } from "~/data/testimonials";
---

{/*
 * Testimonials — cinematic dark mode section. Single hero quote on a deep
 * navy canvas with floating pink/blue blobs, smaller follow-ups in glass
 * cards beneath.
 */}
<section class="relative bg-[var(--color-ink)] text-[var(--color-blush)] overflow-hidden">
  <div class="absolute -top-12 -left-20 pointer-events-none opacity-50" aria-hidden="true">
    <div class="w-[480px] h-[480px] blob-2" style="background:radial-gradient(circle, var(--color-rose-rich), transparent 65%);"></div>
  </div>
  <div class="absolute -bottom-20 -right-12 pointer-events-none opacity-40" aria-hidden="true">
    <div class="w-[560px] h-[560px] blob-3" style="background:radial-gradient(circle, var(--color-sky-deep), transparent 60%);"></div>
  </div>

  <div class="relative container-edge py-24 md:py-36">
    <div class="max-w-2xl reveal">
      <p class="credit-line text-[var(--color-rose)] flex items-center gap-3">
        <span class="w-6 h-px bg-[var(--color-rose)]"></span>
        Chapter 04 — From our patients
      </p>
      <h2 class="display-2 mt-6 !text-[var(--color-paper)]">
        Twenty years of <span class="accent-italic !text-[var(--color-rose)]">word of mouth.</span>
      </h2>
    </div>

    {/* Hero quote */}
    <figure class="reveal mt-16 max-w-4xl">
      <p class="font-display text-6xl !text-[var(--color-rose)]/40 leading-none">"</p>
      <blockquote class="mt-2 font-display font-extralight text-3xl md:text-5xl leading-[1.15] tracking-tight !text-[var(--color-paper)]">
        {testimonials[0].quote}
      </blockquote>
      <figcaption class="mt-8 flex items-center gap-4 text-sm">
        <span class="w-10 h-px bg-[var(--color-rose)]"></span>
        <span class="font-bold !text-[var(--color-paper)]">{testimonials[0].name}</span>
        <span class="opacity-50">·</span>
        <span class="opacity-80">{testimonials[0].treatment}</span>
      </figcaption>
    </figure>

    {/* Smaller follow-up quotes */}
    <div class="mt-16 grid gap-5 md:grid-cols-3">
      {testimonials.slice(1).map((t, i) => (
        <figure
          class="reveal glass !bg-[color-mix(in_oklab,var(--color-paper)_8%,transparent)] !border-[color-mix(in_oklab,var(--color-paper)_18%,transparent)] p-7"
          style={`transition-delay:${i * 80}ms`}
        >
          <div class="flex items-center gap-1 text-[var(--color-rose)]" aria-label={`${t.rating} out of 5`}>
            {Array.from({ length: t.rating }).map(() => (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01L12 2Z"/>
              </svg>
            ))}
          </div>
          <blockquote class="mt-4 text-base leading-relaxed !text-[var(--color-paper)]">
            {t.quote}
          </blockquote>
          <figcaption class="mt-5 text-xs uppercase tracking-[0.22em] font-bold text-[var(--color-rose)]">
            {t.name} <span class="opacity-50">·</span> {t.treatment}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
