---
/**
 * Soft cosmetic-cream swirl backdrop for the hero — pure SVG + CSS, no
 * stock photography. Layered radial gradients + a SVG turbulence "smoke"
 * give the same blurred-cream feel as the Augustinus Bader / Celestia hero.
 */
---

<div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none" aria-hidden="true">
  {/* Base wash */}
  <div
    class="absolute inset-0"
    style="background:
      radial-gradient(60% 70% at 50% 45%, color-mix(in oklab, var(--color-rose-soft) 70%, transparent) 0%, transparent 70%),
      radial-gradient(40% 50% at 12% 18%, color-mix(in oklab, var(--color-sage) 50%, transparent) 0%, transparent 70%),
      radial-gradient(40% 50% at 88% 22%, color-mix(in oklab, var(--color-rose) 35%, transparent) 0%, transparent 70%),
      linear-gradient(180deg, var(--color-cashmere-soft) 0%, var(--color-cashmere) 100%);"
  ></div>

  {/* Big SVG cream-swirl in the centre */}
  <svg
    class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-[55%] w-[80vw] max-w-[1100px] aspect-square opacity-70"
    viewBox="0 0 800 800"
    fill="none"
  >
    <defs>
      <radialGradient id="swirl-core" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#fce5e5"/>
        <stop offset="0.55" stop-color="#f3cdce"/>
        <stop offset="0.85" stop-color="#eba6a9" stop-opacity="0.5"/>
        <stop offset="1" stop-color="#eba6a9" stop-opacity="0"/>
      </radialGradient>
      <radialGradient id="swirl-inner" cx="0.5" cy="0.45" r="0.35">
        <stop offset="0" stop-color="#fdfaf3"/>
        <stop offset="0.5" stop-color="#f7d9da" stop-opacity="0.6"/>
        <stop offset="1" stop-color="#f3cdce" stop-opacity="0"/>
      </radialGradient>
      <filter id="blur-soft">
        <feGaussianBlur stdDeviation="20"/>
      </filter>
    </defs>
    <circle cx="400" cy="400" r="380" fill="url(#swirl-core)" filter="url(#blur-soft)"/>
    <circle cx="400" cy="380" r="240" fill="url(#swirl-inner)" filter="url(#blur-soft)"/>
    {/* Spiral ridges to suggest cream texture */}
    <g stroke="#f3cdce" stroke-width="1.2" fill="none" opacity="0.45">
      <path d="M 400 400 m -180 0 a 180 180 0 1 0 360 0 a 180 180 0 1 0 -360 0" />
      <path d="M 400 400 m -140 0 a 140 140 0 1 0 280 0 a 140 140 0 1 0 -280 0" />
      <path d="M 400 400 m -100 0 a 100 100 0 1 0 200 0 a 100 100 0 1 0 -200 0" />
      <path d="M 400 400 m -65 0 a 65 65 0 1 0 130 0 a 65 65 0 1 0 -130 0" />
    </g>
  </svg>

  {/* Subtle film grain on top */}
  <div
    class="absolute inset-0 opacity-30 mix-blend-multiply"
    style="background-image: url(&quot;data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.15'/></svg>&quot;);"
  ></div>
</div>
