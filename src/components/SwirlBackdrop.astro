---
/**
 * Atmospheric mesh backdrop — soft blush pink fading into powder blue,
 * with a warm cream centre and a faint cosmetic-cream "swirl" disk.
 * All CSS + SVG, no stock photography. Used behind the hero only.
 */
---

<div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none" aria-hidden="true">
  {/* Mesh wash — pink top-right, blue bottom-left, paper centre. */}
  <div
    class="absolute inset-0"
    style="background:
      radial-gradient(50% 60% at 88% 8%, color-mix(in oklab, var(--color-blush-deep) 75%, transparent) 0%, transparent 65%),
      radial-gradient(55% 65% at 6% 88%, color-mix(in oklab, var(--color-sky-mid) 55%, transparent) 0%, transparent 70%),
      radial-gradient(45% 55% at 92% 92%, color-mix(in oklab, var(--color-blush) 70%, transparent) 0%, transparent 65%),
      radial-gradient(40% 50% at 8% 12%, color-mix(in oklab, var(--color-sky-soft) 60%, transparent) 0%, transparent 70%),
      linear-gradient(170deg, var(--color-paper) 0%, var(--color-cream) 100%);"
  ></div>

  {/* Centre cosmetic swirl — soft blurred concentric rings. */}
  <svg
    class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-[55%] w-[85vw] max-w-[1200px] aspect-square opacity-55"
    viewBox="0 0 800 800"
    fill="none"
  >
    <defs>
      <radialGradient id="swirl-core" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#fdfaf7"/>
        <stop offset="0.45" stop-color="#fde7e8" stop-opacity="0.85"/>
        <stop offset="0.8" stop-color="#dce7ee" stop-opacity="0.45"/>
        <stop offset="1" stop-color="#dce7ee" stop-opacity="0"/>
      </radialGradient>
      <radialGradient id="swirl-inner" cx="0.5" cy="0.45" r="0.32">
        <stop offset="0" stop-color="#ffffff"/>
        <stop offset="0.6" stop-color="#fce5e5" stop-opacity="0.7"/>
        <stop offset="1" stop-color="#fce5e5" stop-opacity="0"/>
      </radialGradient>
      <filter id="blur-soft">
        <feGaussianBlur stdDeviation="22"/>
      </filter>
    </defs>
    <circle cx="400" cy="400" r="380" fill="url(#swirl-core)" filter="url(#blur-soft)"/>
    <circle cx="400" cy="380" r="240" fill="url(#swirl-inner)" filter="url(#blur-soft)"/>
    <g stroke="#f3cdce" stroke-width="1" fill="none" opacity="0.35">
      <circle cx="400" cy="400" r="180"/>
      <circle cx="400" cy="400" r="140"/>
      <circle cx="400" cy="400" r="100"/>
      <circle cx="400" cy="400" r="65"/>
    </g>
    <g stroke="#b8ccd9" stroke-width="0.8" fill="none" opacity="0.3">
      <circle cx="400" cy="400" r="320"/>
      <circle cx="400" cy="400" r="270"/>
    </g>
  </svg>

  {/* Subtle film grain. */}
  <div
    class="absolute inset-0 opacity-25 mix-blend-multiply"
    style="background-image: url(&quot;data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.15'/></svg>&quot;);"
  ></div>
</div>
