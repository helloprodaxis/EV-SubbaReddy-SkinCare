---
interface Props {
  eyebrow: string;
  title: string;
  italic?: string;
  subtitle?: string;
}
const { eyebrow, title, italic, subtitle } = Astro.props;
---

<section class="relative overflow-hidden">
  <div
    class="absolute inset-0 -z-10 pointer-events-none"
    aria-hidden="true"
    style="background:
      radial-gradient(45% 50% at 12% 0%, color-mix(in oklab, var(--color-rose) 55%, transparent), transparent 70%),
      radial-gradient(40% 50% at 90% 30%, color-mix(in oklab, var(--color-sage-soft) 45%, transparent), transparent 70%),
      linear-gradient(180deg, var(--color-cream-warm) 0%, var(--color-cream) 100%);"
  ></div>

  <div class="container-edge pt-16 md:pt-24 pb-16 md:pb-20">
    <p class="eyebrow flex items-center gap-3 reveal">
      <span class="inline-block w-8 h-px bg-[var(--color-clay-deep)]"></span>
      {eyebrow}
    </p>
    <h1 class="display-1 mt-5 max-w-[16ch] reveal">
      {title}
      {italic && (<><br /><span class="accent-italic">{italic}</span></>)}
    </h1>
    {subtitle && (
      <p class="lead mt-7 max-w-xl reveal">{subtitle}</p>
    )}
  </div>
  <div class="hairline"></div>
</section>
