---
import { site } from "~/data/site";

const mapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address.mapsQuery)}`;
---

<section class="container-edge py-24 md:py-32">
  <div class="grid gap-12 lg:grid-cols-12 items-center">
    <div class="lg:col-span-6 reveal">
      <p class="credit-line text-[var(--color-rose-deep)] flex items-center gap-3">
        <span class="w-6 h-px bg-[var(--color-rose-deep)]"></span>
        Chapter 05 — We have moved
      </p>
      <h2 class="display-2 mt-6">
        Find us at our
        <br />
        <span class="accent-italic">new home.</span>
      </h2>
      <p class="lead mt-6 max-w-lg">
        The clinic recently shifted to a larger building — same neighbourhood, more
        space, calmer rooms, free on-site parking.
      </p>

      <address class="not-italic mt-8 font-display text-xl md:text-2xl font-light leading-relaxed text-[var(--color-ink)]">
        {site.address.line1}<br />
        <span class="text-[var(--color-ink-mid)]">{site.address.line2}</span><br />
        <span class="text-[var(--color-ink-mid)]">{site.address.area}, {site.address.city}</span>
      </address>

      <div class="flex flex-wrap gap-3 mt-8">
        <a href={mapsLink} target="_blank" rel="noopener" class="btn btn-primary">
          Get Directions
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a href={`tel:${site.phones[0].tel}`} class="btn btn-ghost">
          {site.phones[0].number}
        </a>
      </div>
    </div>

    <div class="lg:col-span-6 reveal">
      <a
        href={mapsLink}
        target="_blank"
        rel="noopener"
        class="block group relative aspect-[4/3] overflow-hidden shadow-[var(--shadow-cinema)] blob-1 transition-all duration-700 hover:[border-radius:var(--r-soft-lg)]"
      >
        <div
          class="absolute inset-0"
          style="background:
            radial-gradient(circle at 30% 30%, color-mix(in oklab, var(--color-sky-mid) 80%, transparent) 0%, transparent 45%),
            radial-gradient(circle at 70% 60%, color-mix(in oklab, var(--color-blush) 90%, transparent) 0%, transparent 45%),
            linear-gradient(180deg, var(--color-paper), var(--color-sky-soft));"
        ></div>

        <svg class="absolute inset-0 w-full h-full opacity-25" viewBox="0 0 600 450" fill="none" stroke="var(--color-ink)" stroke-width="0.6" aria-hidden="true">
          <path d="M0 100 Q150 80 300 130 T600 110" />
          <path d="M0 180 Q200 160 400 200 T600 190" />
          <path d="M0 260 Q180 280 360 250 T600 280" />
          <path d="M0 340 Q220 360 440 330 T600 360" />
          <path d="M120 0 Q140 200 100 450" />
          <path d="M280 0 Q260 220 320 450" />
          <path d="M460 0 Q480 220 440 450" />
        </svg>

        <div class="absolute inset-0 grid place-items-center">
          <div class="relative">
            <span
              class="absolute inset-0 -m-6 rounded-full bg-[var(--color-rose-rich)]/30 animate-ping"
              aria-hidden="true"
            ></span>
            <span class="relative grid place-items-center w-16 h-16 rounded-full bg-[var(--color-ink)] text-[var(--color-rose)] shadow-lg">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M12 22s-7-7.58-7-12a7 7 0 1 1 14 0c0 4.42-7 12-7 12Z" stroke-linejoin="round"/>
                <circle cx="12" cy="10" r="2.5"/>
              </svg>
            </span>
          </div>
        </div>

        <div class="absolute bottom-6 left-6 right-6 flex items-center justify-between text-[var(--color-ink)]">
          <div>
            <p class="text-[0.68rem] uppercase tracking-[0.22em] font-bold text-[var(--color-rose-deep)]">Clinic</p>
            <p class="font-display text-lg leading-tight font-light">{site.address.area}, {site.city}</p>
          </div>
          <span class="text-xs uppercase tracking-[0.18em] font-bold text-[var(--color-rose-rich)] group-hover:underline">
            Open in Maps ↗
          </span>
        </div>
      </a>
    </div>
  </div>
</section>
