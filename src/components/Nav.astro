---
import { site } from "~/data/site";
import Leaf from "./Leaf.astro";

const links = [
  { href: "/",           label: "Home" },
  { href: "/about",      label: "About" },
  { href: "/treatments", label: "Treatments" },
  { href: "/doctors",    label: "Doctors" },
  { href: "/contact",    label: "Contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  id="site-nav"
  class="sticky top-0 z-40 border-b border-[color-mix(in_oklab,var(--color-laurel)_8%,transparent)] backdrop-blur-md bg-[color-mix(in_oklab,var(--color-cashmere)_82%,transparent)]"
  transition:persist
>
  <div class="container-edge flex items-center justify-between gap-6 py-4 md:py-5">
    <a href="/" class="flex items-center gap-3 group" aria-label={site.name}>
      <span
        class="grid place-items-center w-10 h-10 bg-[var(--color-laurel)] text-[var(--color-cashmere-soft)] font-display text-xl font-light leading-none transition-transform group-hover:scale-105 blob-1"
        aria-hidden="true"
      >
        S
      </span>
      <span class="hidden sm:flex flex-col leading-tight">
        <span class="font-display text-[1rem] font-light tracking-tight text-[var(--color-laurel)]">
          Dr. E.V. Subba Reddy
        </span>
        <span class="text-[0.66rem] uppercase tracking-[0.22em] font-bold text-[var(--color-olive)]">
          Advanced Skin &amp; Laser Centre
        </span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "relative px-4 py-2 text-[0.78rem] font-bold uppercase tracking-[0.16em] transition-colors",
            isActive(link.href)
              ? "text-[var(--color-rose-deep)]"
              : "text-[var(--color-ink-soft)] hover:text-[var(--color-laurel)]",
          ]}
        >
          {link.label}
          {isActive(link.href) && (
            <span
              class="absolute left-4 right-4 -bottom-0.5 h-px bg-[var(--color-rose-deep)]"
              aria-hidden="true"
            />
          )}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={`tel:${site.phones[0].tel}`}
        class="hidden md:inline-flex items-center gap-2 text-[0.85rem] text-[var(--color-ink-soft)] hover:text-[var(--color-laurel)]"
        aria-label="Call clinic"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {site.phones[0].number}
      </a>
      <a href="/book" class="btn btn-primary !py-2.5 !px-4 text-[0.72rem]">
        Book Visit
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <button
        id="nav-toggle"
        class="lg:hidden grid place-items-center w-10 h-10 rounded-full border border-[color-mix(in_oklab,var(--color-laurel)_15%,transparent)]"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-[color-mix(in_oklab,var(--color-laurel)_8%,transparent)] bg-[var(--color-cashmere)]"
  >
    <nav class="container-edge flex flex-col py-3" aria-label="Mobile">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "py-3 text-base font-medium border-b border-[color-mix(in_oklab,var(--color-laurel)_6%,transparent)] last:border-0",
            isActive(link.href)
              ? "text-[var(--color-rose-deep)]"
              : "text-[var(--color-ink-soft)]",
          ]}
        >
          {link.label}
        </a>
      ))}
      <a href={`tel:${site.phones[0].tel}`} class="mt-3 text-sm text-[var(--color-ink-muted)]">
        {site.phones[0].number}
      </a>
    </nav>
  </div>
</header>

<script>
  const setupNav = () => {
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!toggle || !menu) return;
    const handler = () => {
      const open = menu.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };
    toggle.addEventListener("click", handler);
  };
  setupNav();
  document.addEventListener("astro:page-load", setupNav);
</script>
