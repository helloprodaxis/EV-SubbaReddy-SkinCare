---
import { site } from "~/data/site";

const links = [
  { href: "/about",      label: "About" },
  { href: "/treatments", label: "Treatments" },
  { href: "/doctors",    label: "Doctors" },
  { href: "/contact",    label: "Contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

{/*
 * Nav — minimal floating header (Aesop / Celestia inspired).
 * Tiny rose monogram + clinic name on left, centre-spaced links, circular
 * arrow CTA on the right. No borders, no surface — only a soft cashmere
 * blur behind on scroll.
 */}
<header
  id="site-nav"
  class="sticky top-0 z-40 backdrop-blur-md bg-[color-mix(in_oklab,var(--color-cashmere)_70%,transparent)]"
  transition:persist
>
  <div class="container-edge grid grid-cols-3 items-center gap-6 py-5 md:py-6">
    {/* Brand monogram + name */}
    <a href="/" class="flex items-center gap-3 group justify-self-start" aria-label={site.name}>
      <span
        class="grid place-items-center w-9 h-9 rounded-full bg-[var(--color-rose-deep)] text-[var(--color-cashmere-soft)] font-display text-sm font-bold leading-none transition-transform group-hover:rotate-12"
        aria-hidden="true"
      >
        +
      </span>
      <span class="hidden sm:flex flex-col leading-tight">
        <span class="font-display text-[0.92rem] font-semibold tracking-tight text-[var(--color-laurel)]">
          Subba Reddy
        </span>
        <span class="text-[0.6rem] uppercase tracking-[0.22em] font-bold text-[var(--color-olive)]">
          Skin · Laser · Hair
        </span>
      </span>
    </a>

    {/* Centre nav links */}
    <nav class="hidden lg:flex items-center justify-center gap-9" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "relative text-[0.72rem] font-bold uppercase tracking-[0.24em] transition-colors py-2",
            isActive(link.href)
              ? "text-[var(--color-rose-deep)]"
              : "text-[var(--color-laurel)] hover:text-[var(--color-rose-deep)]",
          ]}
        >
          {link.label}
          {isActive(link.href) && (
            <span class="absolute left-0 right-0 -bottom-0 h-px bg-[var(--color-rose-deep)]" aria-hidden="true" />
          )}
        </a>
      ))}
    </nav>

    {/* Right side — circular CTA */}
    <div class="flex items-center gap-3 justify-self-end">
      <a
        href="/book"
        class="hidden md:inline-flex items-center gap-3 text-[0.72rem] font-bold uppercase tracking-[0.24em] text-[var(--color-laurel)] hover:text-[var(--color-rose-deep)]"
      >
        <span>Get Started</span>
        <span class="grid place-items-center w-10 h-10 rounded-full bg-[var(--color-white)] shadow-[0_4px_14px_rgb(45_54_43/0.12)] text-[var(--color-laurel)] transition-transform hover:rotate-45" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
          </svg>
        </span>
      </a>
      <button
        id="nav-toggle"
        class="lg:hidden grid place-items-center w-10 h-10 rounded-full border border-[color-mix(in_oklab,var(--color-laurel)_15%,transparent)]"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-[color-mix(in_oklab,var(--color-laurel)_8%,transparent)] bg-[var(--color-cashmere)]"
  >
    <nav class="container-edge flex flex-col py-3" aria-label="Mobile">
      {[{ href: "/", label: "Home" }, ...links].map((link) => (
        <a
          href={link.href}
          class:list={[
            "py-3 text-base font-medium border-b border-[color-mix(in_oklab,var(--color-laurel)_6%,transparent)] last:border-0",
            isActive(link.href) ? "text-[var(--color-rose-deep)]" : "text-[var(--color-ink-soft)]",
          ]}
        >
          {link.label}
        </a>
      ))}
      <a href={`tel:${site.phones[0].tel}`} class="mt-3 text-sm text-[var(--color-ink-muted)]">
        {site.phones[0].number}
      </a>
    </nav>
  </div>
</header>

<script>
  const setupNav = () => {
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!toggle || !menu) return;
    const handler = () => {
      const open = menu.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };
    toggle.addEventListener("click", handler);
  };
  setupNav();
  document.addEventListener("astro:page-load", setupNav);
</script>
