---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PageHeader from "~/components/PageHeader.astro";
import { doctors } from "~/data/doctors";
import { site } from "~/data/site";

const palette = [
  {
    bg: "var(--color-sky-soft)",
    text: "var(--color-sky-rich)",
    accent: "var(--color-sky-deep)",
    avatar: "linear-gradient(135deg, #ffffff 0%, #b8ccd9 60%, #5c7a8a 100%)",
  },
  {
    bg: "var(--color-blush)",
    text: "var(--color-mauve)",
    accent: "var(--color-rose-rich)",
    avatar: "linear-gradient(135deg, #ffffff 0%, #f3cdce 55%, #c97583 100%)",
  },
  {
    bg: "var(--color-ink)",
    text: "var(--color-blush)",
    accent: "var(--color-rose)",
    avatar: "linear-gradient(135deg, #2a3741 0%, #4a5560 60%, #c97583 100%)",
  },
];

const initials = (name: string) =>
  name.split(" ").slice(1).map((s) => s[0]).join("");
---

<BaseLayout
  title={`Doctors — ${site.fullName}`}
  description={`Meet the dermatologists at ${site.fullName}, Kadapa.`}
>
  <PageHeader
    eyebrow="Chapter 03 — The Doctors"
    title="Three specialists."
    italic="One standard of care."
    subtitle="Each doctor leads the part of the practice their training prepared them for. You'll always know which doctor handles your concern — and why."
  />

  <section class="container-edge py-16 md:py-24 space-y-24">
    {doctors.map((d, i) => {
      const c = palette[i];
      return (
        <article
          id={d.slug}
          class="grid gap-12 lg:grid-cols-12 items-center scroll-mt-24"
          class:list={i % 2 === 1 ? "lg:[&>*:first-child]:order-2" : ""}
        >
          <div class="lg:col-span-5 reveal">
            <div
              class="relative aspect-[4/5] blob-1 overflow-hidden shadow-[var(--shadow-cinema)] transition-all duration-700 hover:[border-radius:var(--r-organic-2)] p-10"
              style={`background:${c.bg}; color:${c.text};`}
            >
              {/* Big initials block — centre */}
              <div class="absolute inset-0 grid place-items-center">
                <span
                  class="font-display text-[8rem] font-extralight opacity-90 leading-none tracking-tighter"
                  style={`color:${c.text};`}
                >
                  {initials(d.name)}
                </span>
              </div>

              {/* Top stripe */}
              <div class="absolute top-8 left-8 right-8 flex justify-between text-[0.66rem] uppercase tracking-[0.24em] font-bold opacity-80">
                <span>0{i + 1} / 0{doctors.length}</span>
                <span>{d.qualifications}</span>
              </div>

              {/* Bottom stripe */}
              <div class="absolute bottom-8 left-8 right-8">
                <p class="text-[0.66rem] uppercase tracking-[0.24em] font-bold opacity-80">{d.role}</p>
                <p
                  class="font-display text-2xl mt-1 font-light leading-tight"
                  style={`color:${c.text};`}
                >
                  {d.name}
                </p>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7 reveal">
            <p class="credit-line text-[var(--color-rose-deep)] flex items-center gap-3">
              <span class="w-6 h-px bg-[var(--color-rose-deep)]"></span>
              Doctor 0{i + 1}
            </p>
            <h2 class="display-2 mt-5 text-[var(--color-ink)]">{d.name}</h2>
            <p class="text-[0.7rem] text-[var(--color-rose-deep)] mt-3 uppercase tracking-[0.24em] font-bold">
              {d.specialties.join(" · ")}
            </p>
            <p class="lead mt-6 max-w-xl">{d.bio}</p>

            <ul class="mt-8 space-y-3">
              {d.highlights.map((h) => (
                <li class="flex items-start gap-3 text-[var(--color-ink-soft)]">
                  <span class="mt-2 inline-block w-3 h-px bg-[var(--color-rose-rich)] shrink-0"></span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>

            <a href="/book" class="btn btn-rose mt-10">
              Book with {d.name.split(" ")[1]}
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      );
    })}
  </section>
</BaseLayout>
