---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PageHeader from "~/components/PageHeader.astro";
import BookingForm from "~/components/BookingForm.svelte";
import { site } from "~/data/site";
---

<BaseLayout
  title={`Book an appointment — ${site.name}`}
  description="Request a dermatology consultation at our Kadapa clinic. Reception will call to confirm your slot."
>
  <PageHeader
    eyebrow="Book a visit"
    title="A consult."
    italic="Then a clear plan."
    subtitle="Tell us a little about what's bothering you. Our reception will call you back to confirm your slot — usually within the same business day."
  />

  <section class="container-edge py-16 md:py-24">
    <div class="grid gap-12 lg:grid-cols-12 items-start">
      <div class="lg:col-span-7 reveal">
        <div class="card !p-8 md:!p-12">
          <BookingForm client:load />
        </div>
      </div>

      <aside class="lg:col-span-5 lg:sticky lg:top-28 self-start space-y-8">
        <div class="reveal">
          <p class="eyebrow">Walk-ins welcome</p>
          <h2 class="display-2 mt-3 !text-[2rem]">
            Or just <span class="accent-italic">drop in.</span>
          </h2>
          <p class="lead mt-4">
            We keep slots open every day for walk-ins. Booked appointments simply get
            priority — no other difference in care.
          </p>
        </div>

        <div class="card reveal">
          <p class="eyebrow">Hours</p>
          <dl class="mt-4 space-y-2 text-sm text-[var(--color-ink-soft)]">
            <div class="flex justify-between">
              <dt>Monday – Saturday</dt>
              <dd>{site.hours.weekdays.morning}</dd>
            </div>
            <div class="flex justify-between">
              <dt></dt>
              <dd>{site.hours.weekdays.evening}</dd>
            </div>
            <div class="flex justify-between">
              <dt>Sunday</dt>
              <dd class="text-[var(--color-clay-deep)]">{site.hours.sunday}</dd>
            </div>
          </dl>
        </div>

        <div class="card reveal">
          <p class="eyebrow">Direct contact</p>
          <ul class="mt-4 space-y-3">
            {site.phones.map((p) => (
              <li class="flex items-center justify-between text-sm">
                <span class="text-[var(--color-ink-muted)]">{p.label}</span>
                <a href={`tel:${p.tel}`} class="font-display text-lg text-[var(--color-ink)] hover:text-[var(--color-clay-deep)]">
                  {p.number}
                </a>
              </li>
            ))}
          </ul>
          <a
            href={`https://wa.me/${site.whatsapp.replace(/\D/g, "")}`}
            class="btn btn-ghost mt-6 w-full justify-center"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.978-1.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.494.099-.198.05-.371-.025-.52-.075-.149-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/>
            </svg>
            WhatsApp Us
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
