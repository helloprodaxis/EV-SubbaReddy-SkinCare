---
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout title="Not found">
  <section class="container-edge min-h-[70vh] grid place-items-center text-center py-24">
    <div class="reveal">
      <p class="eyebrow">Error 404</p>
      <h1 class="display-1 mt-4">
        Couldn't find <span class="accent-italic">that page.</span>
      </h1>
      <p class="lead mt-6 max-w-md mx-auto">
        The link may have moved. Try the homepage, or jump straight to booking.
      </p>
      <div class="flex flex-wrap gap-3 justify-center mt-8">
        <a href="/" class="btn btn-primary">Back home</a>
        <a href="/book" class="btn btn-ghost">Book a visit</a>
      </div>
    </div>
  </section>
</BaseLayout>
