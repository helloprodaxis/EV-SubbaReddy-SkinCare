---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PageHeader from "~/components/PageHeader.astro";
import { site } from "~/data/site";

const principles = [
  {
    title: "Trained, not trend-led",
    body: "Three decades of combined dermatology training across MD, DD, and DDVL programmes — including Dr. Subba Reddy's tenure as Registrar at JIPMER, Pondicherry. We practice the way we were taught.",
  },
  {
    title: "One roof, full spectrum",
    body: "From a five-minute mole removal to a six-month melasma protocol, you do not need to be referred elsewhere. Medical dermatology, laser, cosmetology and allergy — all in one clinic.",
  },
  {
    title: "Transparent pricing",
    body: "Every treatment plan is shared in writing before you commit. No mystery upcharges. No 'special offers' that exist only because the base price is inflated.",
  },
  {
    title: "Built for Indian skin",
    body: "Lasers, peels and protocols are calibrated for darker, thicker Indian skin — not borrowed unchanged from Western textbooks. This matters more than most clinics admit.",
  },
];
---

<BaseLayout
  title={`About — ${site.name}`}
  description={`How ${site.name} approaches dermatology — clinical-first, transparent, built for Indian skin.`}
>
  <PageHeader
    eyebrow={`Since ${site.established}`}
    title="A clinic built on"
    italic="answers, not appointments."
    subtitle="Two decades, three doctors, and one stubborn idea — that small-town India deserves the same standard of dermatology as Hyderabad or Bangalore."
  />

  <section class="container-edge py-20 md:py-28">
    <div class="grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5 lg:sticky lg:top-28 self-start reveal">
        <p class="eyebrow">The story</p>
        <h2 class="display-2 mt-4">
          From Pondicherry
          <br />
          <span class="accent-italic">to Kadapa.</span>
        </h2>
        <p class="lead mt-6">
          After his tenure as Registrar at JIPMER — one of India's premier medical
          institutions — Dr. E.V. Subba Reddy returned home to Kadapa with one mission:
          bring metro-grade dermatology to a city that had been overlooked.
        </p>
        <p class="lead mt-4">
          Twenty-plus years and tens of thousands of patients later, the clinic now
          spans three specialists, every standard laser modality, and a recently
          expanded building to match the demand.
        </p>
      </div>

      <ol class="lg:col-span-7 space-y-5">
        {principles.map((p, i) => (
          <li class="reveal card !p-8" style={`transition-delay:${i * 60}ms`}>
            <p class="font-display text-xl md:text-2xl text-[var(--color-ink)] leading-tight">
              <span class="text-[var(--color-clay)] mr-3">0{i + 1}</span>
              {p.title}
            </p>
            <p class="mt-3 text-[var(--color-ink-soft)] leading-relaxed">
              {p.body}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-[var(--color-ink)] text-[var(--color-cream)]">
    <div class="container-edge py-24 md:py-32 grid gap-12 lg:grid-cols-12 items-center">
      <div class="lg:col-span-7 reveal">
        <p class="eyebrow !text-[var(--color-clay-soft)]">Step inside</p>
        <h2 class="display-2 mt-4 !text-[var(--color-cream)]">
          A new building.
          <br />
          <span class="accent-italic !text-[var(--color-clay-soft)]">The same care.</span>
        </h2>
        <p class="lead mt-6 !text-[color-mix(in_oklab,var(--color-cream)_80%,transparent)] max-w-lg">
          Our recent move gave us a dedicated laser room, a separate phototherapy bay, a
          quiet consultation suite, and parking that doesn't make you circle the block.
          Same warm, judgement-free experience our patients have always known.
        </p>
        <a href="/contact" class="btn btn-primary !bg-[var(--color-clay)] !text-[var(--color-ink)] hover:!bg-[var(--color-clay-soft)] mt-8">
          Visit the new clinic
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <dl class="lg:col-span-5 grid grid-cols-2 gap-6">
        {[
          { k: "3", v: "Consultation rooms" },
          { k: "1", v: "Dedicated laser bay" },
          { k: "1", v: "Phototherapy suite" },
          { k: "Free", v: "On-site parking" },
        ].map((s) => (
          <div class="p-6 rounded-2xl bg-[color-mix(in_oklab,var(--color-cream)_8%,transparent)] border border-[color-mix(in_oklab,var(--color-cream)_15%,transparent)]">
            <dt class="font-display text-3xl md:text-4xl font-light !text-[var(--color-cream)]">{s.k}</dt>
            <dd class="mt-2 text-xs uppercase tracking-[0.18em] text-[color-mix(in_oklab,var(--color-cream)_65%,transparent)]">
              {s.v}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>
